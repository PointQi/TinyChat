<?xml version="1.0" encoding="utf-8"?>
<!-- 仅 debug 构建：渲染实验室（公式/图表回归 + 出图耗时采样）+ 流式抖动实验台，release 不打包 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="io.tinychat.debug.RenderLabActivity"
            android:exported="true"
            android:label="渲染实验室" />
        <activity
            android:name="io.tinychat.debug.StreamingLabActivity"
            android:exported="true"
            android:label="流式抖动" />
        <activity
            android:name="io.tinychat.debug.ArchiveLabActivity"
            android:exported="true"
            android:label="导入导出验收" />
        <activity
            android:name="io.tinychat.debug.CodeLabActivity"
            android:exported="true"
            android:label="代码着色验收" />

        <!-- 崩溃兜底的验收开关（M9-2）：用 adb 广播 io.tinychat.debug.CRASH 触发，kind 取 main/bg/stream -->
        <receiver
            android:name="io.tinychat.debug.CrashLabReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.tinychat.debug.CRASH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
