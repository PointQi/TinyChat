<?xml version="1.0" encoding="utf-8"?>
<!--
  崩溃页（M9-2）。刻意用传统 View + 这个布局文件，不走 Compose：
  崩溃现场的进程已经不干净了，越少的初始化路径越可能把这一屏画出来。
  文案由 CrashActivity 按状态填，这里只管排版。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tc_crash_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="40dp"
        android:paddingEnd="28dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/crash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/tc_crash_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/crash_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.45"
            android:textColor="@color/tc_crash_body"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/crash_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_crash_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textColor="@color/tc_crash_on_brand"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/crash_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:textColor="@color/tc_crash_body"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
