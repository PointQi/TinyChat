<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      决策 16：没有自建启动页。这里的 windowBackground 只是为了抹平
      「系统 SplashScreen 结束后 → Compose 首帧」之间的闪烁，不承载任何欢迎内容。
    -->
    <style name="Theme.TinyChat" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/tc_window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!--
      M8-7 启动体验：只设背景色 + 应用图标，**不加动画、不加 setKeepOnScreenCondition**。
      Android 12+ 的系统 SplashScreen 无法移除，能做的是让它最短、最不突兀（02 §11.1）。
    -->
    <style name="Theme.TinyChat.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tc_window_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.TinyChat</item>
    </style>

    <!--
      崩溃页（M9-2）跑在独立的 :crash 进程里，刻意不用 Compose、不引 Material 组件，
      只给一个最朴素的深色底窗口——它存在的唯一目的是「一定画得出来」。
    -->
    <style name="Theme.TinyChat.Crash" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tc_crash_bg</item>
        <item name="android:statusBarColor">@color/tc_crash_bg</item>
        <item name="android:navigationBarColor">@color/tc_crash_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
